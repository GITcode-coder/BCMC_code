      bcmc_hr <- as.numeric(dat[, 3])

      extremum_index <- if (m == 2L) {which.min(bcmc_hr)} else {which.max(bcmc_hr)}

      result_index <- result_index + 1L

      result_rows[[result_index]] <- data.frame(
        fre = fre,
