# 每次生成一个 data twin 并拟合模型
run_one_sim_hrs <- function(seed, fre, p_list_s_ste) {
  set.seed(seed)

  n <- nrow(dat_hrs)
  k <- dim(p_list_s_ste)[3]

  # 每位受试者的协变量值在随访期间保持不变，
