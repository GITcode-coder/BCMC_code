# 对给定频率构造细化后的转移矩阵序列
make_p_list_s_ste <- function(p_list_s, fre) {
  if (!fre %in% c(24L, 6L, 3L)) {
    stop("fre 只能取 24、6 或 3。")
  }

  n_sub <- 24L / fre
  k <- 10L * n_sub
  p_list_s_ste <- array(0, dim = c(3L, 3L, k))

  for (i in seq_len(10L)) {
    p_step <- p_list_s[, , i]

    # fre=24: 不分解；fre=6: 四次根；fre=3: 八次根
    if (n_sub > 1L) {
      n_sqrt <- as.integer(log2(n_sub))
      for (j in seq_len(n_sqrt)) {
        p_step <- expm::sqrtm(p_step)
      }
      p_step <- Re(p_step)
    }

    # 清理数值误差并重新标准化每一行
    p_step[p_step < 0] <- 0

    for (state_i in 1:3) {
      row_total <- sum(p_step[state_i, ])

      if (is.finite(row_total) && row_total > 0) {
        p_step[state_i, ] <- p_step[state_i, ] / row_total
      } else {
        p_step[state_i, ] <- diag(3)[state_i, ]
      }
    }

    idx <- ((i - 1L) * n_sub + 1L):(i * n_sub)
    p_list_s_ste[, , idx] <- array(
      rep(p_step, n_sub),
      dim = c(3L, 3L, n_sub)
    )
  }

  p_list_s_ste
}
