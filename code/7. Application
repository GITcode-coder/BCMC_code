  x_list <- list()
  x_list[[1]] <- matrix(
    rep(as.numeric(dat_hrs[, 46]), each = k + 1L),
    nrow = n,
    byrow = TRUE
  )
  names(x_list) <- "Covariate1"

  # 模拟每名受试者在 k+1 个时间点的状态
  data_1 <- matrix(NA_integer_, nrow = n, ncol = k + 1L)

  for (i in seq_len(n)) {
    current_state <- as.integer(dat_state[i, 1])

    if (is.na(current_state) || !current_state %in% 1:3) {
      stop("基线状态必须是 1、2 或 3。")
    }

    data_1[i, 1] <- current_state

    for (t in seq_len(k)) {
      current_prob <- p_list_s_ste[current_state, , t]

      next_state <- sample.int(
        n = 3L,
        size = 1L,
        prob = current_prob
      )

      data_1[i, t + 1L] <- next_state
      current_state <- next_state
    }
  }

  wide_data_1 <- as.data.frame(data_1)
  colnames(wide_data_1) <- as.character(seq_len(k + 1L))

  C1 <- data_sur_extract(wide_data_1, x_list, q)
  data_sur <- C1

  data_sur$y <- as.numeric(as.character(data_sur$y))
  data_sur$m <- as.integer(as.character(data_sur$m))
  data_sur$sigema <- as.integer(as.character(data_sur$sigema))
  data_sur$X <- as.numeric(as.character(data_sur$X))

  K_fre <- k

  HR_cox <- beta_of_HR_cox(data_sur, M)

  bcmc_result <- beta_of_bcmc(
    data_sur, M, K_fre, s0, lamstar
  )

  beta_post <- bcmc_result$beta_post_all
  bcmc_posterior <- bcmc_result$bcmc_posterior

  bcmc <- beta_post[
    seq_len(K_fre),
    c(1:3, 6:8, 11:13, 16:18),
    drop = FALSE
  ]

  bcmc_wei <- beta_fit_wei(bcmc, bcmc_posterior, M, K_fre)
  bcmc_lin <- beta_fit_lin(bcmc, bcmc_posterior, M, K_fre)
  bcmc_splin_1 <- beta_fit_splin(bcmc, bcmc_posterior, M, K_fre, 3)
  bcmc_splin_2 <- beta_fit_splin(bcmc, bcmc_posterior, M, K_fre, 4)
  bcmc_splin_3 <- beta_fit_splin(bcmc, bcmc_posterior, M, K_fre, 5)
  bcmc_splin_4 <- beta_fit_splin(bcmc, bcmc_posterior, M, K_fre, 6)

  bcmc_fit_all <- vector("list", M)
  selected_model <- integer(M)

  for (m in seq_len(M)) {
    col <- (m - 1L) * 3L + 1L
    y0 <- bcmc[, col]

    bcmc_all <- list(
      bcmc_wei[[m]],
      bcmc_lin[[m]],
      bcmc_splin_1[[m]],
      bcmc_splin_2[[m]],
      bcmc_splin_3[[m]],
      bcmc_splin_4[[m]]
    )

    n_parm <- c(2, 2, 3, 4, 5, 6)
    zbic_all <- rep(NA_real_, 6L)

    for (mod in seq_len(6L)) {
      y1 <- as.numeric(bcmc_all[[mod]][, 1])

      zbic_all[mod] <- zbic(
        y0,
        log(y1),
        n_parm[mod],
        tau = log(1.25)
      )
    }

    best_mod <- which.min(zbic_all)
    selected_model[m] <- best_mod
    bcmc_fit_all[[m]] <- bcmc_all[[best_mod]]
  }

  # 每个 data_all list 的第 3 列是 BCMC HR
  data_all <- vector("list", M)

  for (m in seq_len(M)) {
    fit <- as.matrix(bcmc_fit_all[[m]])

    if (nrow(fit) != K_fre || ncol(fit) < 3L) {
      stop("BCMC 平滑结果与当前频率的时间网格不一致。")
    }

    data_all[[m]] <- data.frame(
      time_index = seq_len(K_fre),
      bcmc_lwr = fit[, 2],
      bcmc_HR = fit[, 1],
      bcmc_upr = fit[, 3],
      Fre_Cox_HR = rep(as.numeric(HR_cox[m, 1]), K_fre),
      Fre_Cox_lwr = rep(as.numeric(HR_cox[m, 2]), K_fre),
      Fre_Cox_upr = rep(as.numeric(HR_cox[m, 3]), K_fre)
    )
  }

  names(data_all) <- transition_names
  data_all
}

