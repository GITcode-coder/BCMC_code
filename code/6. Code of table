# Generate one weekly cohort per replicate and reuse it across all settings.
for (r in 1:R) {
  cohort_r <- generate_weekly_cohort(r)
  
  wide_data <- as.data.frame(
    do.call(rbind, cohort_r$wide_data_list)
  )
  names(wide_data) <- paste0("t_", 0:K0)
  x_list <- cohort_r$x_list
  
  for (setting_id in seq_len(nrow(unique_settings))) {
    setting <- unique_settings[setting_id, ]
    
    data_all_sim <- run_one_sim(
      seed = r * 1000L + setting_id,
      wide_data = wide_data,
      x_list = x_list,
      K = as.integer(setting$K),
      s0 = setting$s0,
      lamstar = setting$lamstar
    )
    
    data_all_r <- data_all_sim$data_all
    data_all_model_r <- data_all_sim$data_all_model
    
    # Save primary-analysis curves and collect primary-only summaries.
    if (setting_id == primary_id) {
      data_all_r_csv <- do.call(
        rbind,
        lapply(seq_len(M), function(m) {
          out <- data_all_r[[m]]
          out$transition_path <- names(data_all_r)[m]
          out
        })
      )
      rownames(data_all_r_csv) <- NULL
      
      write.csv(
        data_all_r_csv,
        file.path(output_dir, paste0("data_all_", r, ".csv")),
        row.names = FALSE
      )
      
      for (m in 1:M) {
        model_selection_sim[r, m] <-
          data_all_r[[m]]$selected_model[1]
        
        dat_primary <- data_all_r[[m]][, c(2, 3, 6, 9, 12, 15)]
        colnames(dat_primary) <- c(
          "true", "bcmc", "cox", "tv", "rcs", "Crowther"
        )
        
        extremum_time_sim[r, m] <- if (m == 2) {
          which.max(dat_primary$bcmc)
        } else {
          which.min(dat_primary$bcmc)
        }
        
        dat_model <- data_all_model_r[[m]]
        
        for (mod in 1:7) {
          col <- mod * 3
          
          peak <- if (m == 2) {
            which.max(dat_model[, col])
          } else {
            which.min(dat_model[, col])
          }
          
          rang <- max(dat_model[, col], na.rm = TRUE) -
            min(dat_model[, col], na.rm = TRUE)
          
          rmse <- sqrt(mean(
            (dat_model[, 2] - dat_model[, col])^2,
            na.rm = TRUE
          ))
          
          ci_cov <- mean(
            dat_model[, col + 1] <= dat_model[, 2] &
              dat_model[, 2] <= dat_model[, col + 2],
            na.rm = TRUE
          )
          
          ci_wid <- mean(
            abs(dat_model[, col + 1] - dat_model[, col + 2]),
            na.rm = TRUE
          )
          
          table_s13_sim[r, m, mod, ] <-
            c(peak, rang, rmse, ci_cov, ci_wid)
        }
      }
    }
    
    # Table 1 performance metrics for this parameter combination.
    result <- sensitivity_results[[setting_id]]
    
    for (m in 1:M) {
      dat <- data_all_r[[m]][, c(2, 3, 6, 9, 12, 15)]
      colnames(dat) <- c(
        "true", "bcmc", "cox", "tv", "rcs", "Crowther"
      )
      
      ci_95 <- data_all_r[[m]][, c(
        4, 5, 7, 8, 10, 11, 13, 14, 16, 17
      )]
      
      est_list <- list(
        dat$cox,
        dat$tv,
        dat$rcs,
        dat$bcmc,
        dat$Crowther
      )
      
      lwr_list <- list(
        ci_95[, 3],
        ci_95[, 5],
        ci_95[, 7],
        ci_95[, 1],
        ci_95[, 9]
      )
      
      upr_list <- list(
        ci_95[, 4],
        ci_95[, 6],
        ci_95[, 8],
        ci_95[, 2],
        ci_95[, 10]
      )
      
      for (p_method in 1:5) {
        metric <- curve_metrics(
          true = dat$true,
          est = est_list[[p_method]],
          lwr = lwr_list[[p_method]],
          upr = upr_list[[p_method]]
        )
        
        result$bias_sim[r, m, p_method] <- metric["bias"]
        result$mae_sim[r, m, p_method] <- metric["mae"]
        result$mse_sim[r, m, p_method] <- metric["mse"]
        result$rmse_sim[r, m, p_method] <- sqrt(metric["mse"])
        result$smape_sim[r, m, p_method] <- metric["smape"]
        result$ci_cov_sim[r, m, p_method] <- metric["coverage"]
        result$ci_wide_sim[r, m, p_method] <- metric["width"]
      }
    }
    
    sensitivity_results[[setting_id]] <- result
  }
  
  message("Completed simulation replicate ", r, " of ", R)
}


# Summarize the replicate-level results for one parameter combination.
summarize_setting <- function(setting_id, Sensitivity, Value) {
  result <- sensitivity_results[[setting_id]]
  
  do.call(
    rbind,
    lapply(1:M, function(m) {
      do.call(
        rbind,
        lapply(1:5, function(p_method) {
          data.frame(
            Sensitivity = Sensitivity,
            Value = Value,
            Transition = transition_names[m],
            Method = method_names[p_method],
            bias = mean(
              result$bias_sim[, m, p_method],
              na.rm = TRUE
            ),
            bias_5 = boot_ci(
              result$bias_sim[, m, p_method]
            ),
            mae = mean(
              result$mae_sim[, m, p_method],
              na.rm = TRUE
            ),
            mae_5 = boot_ci(
              result$mae_sim[, m, p_method]
            ),
            mse = mean(
              result$mse_sim[, m, p_method],
              na.rm = TRUE
            ),
            mse_5 = boot_ci(
              result$mse_sim[, m, p_method]
            ),
            rmse = mean(
              result$rmse_sim[, m, p_method],
              na.rm = TRUE
            ),
            smape = paste0(
              round(
                mean(
                  result$smape_sim[, m, p_method],
                  na.rm = TRUE
                ),
                2
              ),
              "%"
            ),
            ci_cov = paste0(
              round(
                mean(
                  result$ci_cov_sim[, m, p_method],
                  na.rm = TRUE
                ) * 100,
                2
              ),
              "%"
            ),
            ci_wide = round(
              mean(
                result$ci_wide_sim[, m, p_method],
                na.rm = TRUE
              ),
              2
            ),
            row.names = NULL
          )
        })
      )
    })
  )
}


