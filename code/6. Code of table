  Transition = transition,
  `Extremum type` = extremum_type,
  `True time (weeks)` = true_time,
  `Mean estimated time, weeks (empirical 2.5th–97.5th percentile)` =
    sprintf(
      "%.2f (%.2f, %.2f)",
      mean_time,
      time_lwr,
      time_upr
    ),
  `Timing MAE (weeks)` = round(timing_mae, 2),
