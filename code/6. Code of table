# Performance metrics for one fitted curve.
curve_metrics <- function(true, est, lwr, upr) {
  ok <- is.finite(true) &
    is.finite(est) &
    is.finite(lwr) &
    is.finite(upr)
  
  if (!any(ok)) {
    stop("No finite time points available for performance calculation.")
  }
  
  true <- true[ok]
  est <- est[ok]
  lwr <- lwr[ok]
  upr <- upr[ok]
  
  err <- true - est
  
  out <- c(
    bias = mean(err),
    mae = mean(abs(err)),
    mse = mean(err^2),
    smape = mean(
      2 * abs(err) /
        pmax(abs(true) + abs(est), .Machine$double.eps)
    ) * 100,
    coverage = mean(lwr <= true & true <= upr),
    width = mean(upr - lwr)
  )
  
  stopifnot(abs(out["bias"]) <= out["mae"] + 1e-12)
  out
}


# Generate one weekly cohort per replicate.
# The patient-level weekly trajectories are held in wide_data_list.
generate_weekly_cohort <- function(seed) {
  set.seed(seed)
  
  x_list <- list()
  x_list[[1]] <- matrix(1, nrow = n_patients, ncol = K0)
  x_list[[1]][1:(n_patients / 2), ] <- 0
  names(x_list) <- "Covariate1"
  
  beta_list <- list()
  beta_list[[1]] <- beta_true
  names(beta_list) <- "Covariate1"
  
  tp <- 0:K0
  tmax <- K0
  n_sim <- n_patients
  
  wide_data_list <- vector("list", n_sim)
  
  for (i in seq_len(n_sim)) {
    start_state <- sample(
      c("PFS", "PD"),
      1,
      prob = c(0.75, 0.25)
    )
    
    cont_traj <- sim_one_patient(
      i,
      params,
      tmax,
      start_state,
      x_list,
      beta_list
    )
    
    states <- sur_traj(cont_traj, tp)
    
    wide_data_list[[i]] <- as.numeric(
      factor(
        states,
        levels = c("PFS", "PD", "Death"),
        labels = c("1", "2", "3")
      )
    )
  }
  
  list(
    wide_data_list = wide_data_list,
    x_list = x_list
  )
}


# Fit all methods for one parameter setting using an existing weekly cohort.
run_one_sim <- function(seed, wide_data, x_list, K, s0, lamstar) {
  set.seed(seed)
  
  # Observation times across the fixed follow-up.
  obs_time <- seq(0, K0, length.out = K + 1L)
  
  # For state extraction, use the state at the preceding weekly grid point.
  obser <- as.integer(floor(obs_time))
  obser <- pmax(0L, pmin(K0, obser))
  
  # Keep repeated indices, which occur for K > K0.
  wide_data_1 <- wide_data[
    ,
    c(1L, obser[-1L] + 1L),
    drop = FALSE
  ]
  names(wide_data_1) <- paste0("t_", 0:K)
  
  C1 <- data_sur_extract(wide_data_1, x_list, q)
  
  data_sur <- C1
  data_sur$ID <- data_sur$ID
  data_sur$y <- as.numeric(as.character(data_sur$y))
  data_sur$m <- as.integer(as.character(data_sur$m))
  data_sur$sigema <- as.integer(as.character(data_sur$sigema))
  data_sur$X <- as.numeric(as.character(data_sur$X))
  
  HR_cox <- beta_of_HR_cox(data_sur, M)
  
  HR_TV <- beta_of_HR_TV(data_sur, M, K)
  HR_TV <- HR_TV[, -13]
  
  HR_rcs <- beta_of_HR_rcs(data_sur, M, K)
  HR_rcs <- HR_rcs[, -13]
  
  bcmc_result <- beta_of_bcmc(data_sur, M, K, s0, lamstar)
  beta_post <- bcmc_result$beta_post_all
  bcmc_posterior <- bcmc_result$bcmc_posterior
  bcmc <- beta_post[1:K, c(1:3, 6:8, 11:13, 16:18)]
  
  crowther_result <- beta_of_Crowther(
    data_sur = data_sur,
    M = M,
    K = K,
    df_baseline = 3,
    df_tvc = 2,
    robust_se = TRUE
  )
  HR_Crowther <- crowther_result$HR[, -1]
  
  bcmc_wei <- beta_fit_wei(bcmc, bcmc_posterior, M, K)
  bcmc_lin <- beta_fit_lin(bcmc, bcmc_posterior, M, K)
  bcmc_splin_1 <- beta_fit_splin(bcmc, bcmc_posterior, M, K, 3)
  bcmc_splin_2 <- beta_fit_splin(bcmc, bcmc_posterior, M, K, 4)
  bcmc_splin_3 <- beta_fit_splin(bcmc, bcmc_posterior, M, K, 5)
  bcmc_splin_4 <- beta_fit_splin(bcmc, bcmc_posterior, M, K, 6)
  
  bcmc_fit_all <- list()
  zbic_all_0 <- 0
  selected_model <- integer(M)
  
  for (m in 1:M) {
    col <- (m - 1) * 3 + 1
    y0 <- bcmc[, col]
    
    bcmc_all <- list(
      bcmc_wei[[m]],
      bcmc_lin[[m]],
      bcmc_splin_1[[m]],
      bcmc_splin_2[[m]],
      bcmc_splin_3[[m]],
      bcmc_splin_4[[m]]
    )
    
    zbic_all <- c(0)
    n_parm <- c(2, 2, 3, 4, 5, 6)
    
    for (mod in 1:6) {
      y1 <- as.vector(bcmc_all[[mod]][, 1])
      zbic0 <- zbic(
        y0,
        log(y1),
        n_parm[mod],
        tau = log(1.25)
      )
      zbic_all <- c(zbic_all, zbic0)
    }
    
    zbic_all_0 <- rbind(
      zbic_all_0,
      c(zbic_all[-1], which.min(zbic_all[-1]))
    )
    
    best_mod <- which.min(zbic_all[-1])
    selected_model[m] <- best_mod
    bcmc_fit_all[[m]] <- bcmc_all[[best_mod]]
  }
  
  data_all <- list()
  data_all_model <- list()
  
  # The simulated beta is indexed by the ceiling of elapsed weekly time.
  true_idx <- as.integer(ceiling(obs_time[-1L]))
  true_idx <- pmax(1L, pmin(K0, true_idx))
  
  for (m in 1:M) {
    y_cox <- cbind(
      rep(as.numeric(HR_cox[m, 1]), K),
      rep(as.numeric(HR_cox[m, 2]), K),
      rep(as.numeric(HR_cox[m, 3]), K)
    )
    colnames(y_cox) <- c("cox", "cox_lwr", "cox_upr")
    
    col <- (m - 1) * 3 + 1
    
    y_tv <- cbind(
      HR_TV[, col],
      HR_TV[, col + 1],
      HR_TV[, col + 2]
    )
    colnames(y_tv) <- c("tv", "tv_lwr", "tv_upr")
    
    y_rcs <- cbind(
      HR_rcs[, col],
      HR_rcs[, col + 1],
      HR_rcs[, col + 2]
    )
    colnames(y_rcs) <- c("rcs", "rcs_lwr", "rcs_upr")
    
    y_Crowther <- cbind(
      HR_Crowther[, col],
      HR_Crowther[, col + 1],
      HR_Crowther[, col + 2]
    )
    
    y_true <- exp(beta_true[m, true_idx])
    x <- data.frame(x = 1:K)
    
    data_all[[m]] <- cbind(
      x,
      y_true,
      bcmc_fit_all[[m]],
      y_cox,
      y_tv,
      y_rcs,
      y_Crowther
    )
    data_all[[m]]$selected_model <- selected_model[m]
    
    bcmc_orig <- exp(bcmc[, c(col:(col + 2))])
    
    data_all_model[[m]] <- cbind(
      x,
      y_true,
      bcmc_orig,
      bcmc_lin[[m]],
      bcmc_wei[[m]],
      bcmc_splin_1[[m]],
      bcmc_splin_2[[m]],
      bcmc_splin_3[[m]],
      bcmc_splin_4[[m]]
    )
  }
  
  names(data_all) <- transition_names
  
  list(
    data_all = data_all,
    data_all_model = data_all_model,
    beta_post = beta_post
  )
}


