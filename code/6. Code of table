curve_metrics <- function(true, est, lwr, upr) {
  ok <- is.finite(true) & is.finite(est) & is.finite(lwr) & is.finite(upr)
  if (!any(ok)) stop("No finite time points available for performance calculation")
  true <- true[ok]; est <- est[ok]; lwr <- lwr[ok]; upr <- upr[ok]
  err <- true - est
  out <- c(
    bias = mean(err),
    mae = mean(abs(err)),
    mse = mean(err^2),
    smape = mean(2 * abs(err) / pmax(abs(true) + abs(est), .Machine$double.eps)) * 100,
    coverage = mean(lwr <= true & true <= upr),
    width = mean(upr - lwr)
  )
  stopifnot(abs(out["bias"]) <= out["mae"] + 1e-12)
  out
}


