# Identify unique parameter combinations so overlapping settings are fitted once.
setting_key <- function(K, s0, lamstar) {
  paste(
    sprintf("%.12g", as.numeric(K)),
    sprintf("%.12g", as.numeric(s0)),
    sprintf("%.12g", as.numeric(lamstar)),
    sep = "|"
  )
}

sensitivity_map$key <- mapply(
  setting_key,
  sensitivity_map$K,
  sensitivity_map$s0,
  sensitivity_map$lamstar
)

unique_keys <- unique(sensitivity_map$key)
sensitivity_map$setting_id <- match(
  sensitivity_map$key,
  unique_keys
)

unique_settings <- sensitivity_map[
  match(unique_keys, sensitivity_map$key),
  c("K", "s0", "lamstar", "setting_id"),
  drop = FALSE
]
rownames(unique_settings) <- NULL

primary_id <- sensitivity_map$setting_id[1]


# Store replicate-level metrics for each unique parameter combination.
