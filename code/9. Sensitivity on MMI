library(tidyr)

# ----------------------------------------------------------------------------
# 1. Parameter Settings (from existing code)
# ----------------------------------------------------------------------------

K <- 260                    # number of time points
interval <- 1
tp <- seq(0, interval * K, interval)
M <- 4                      # number of transition paths
n_patients <- 1000        # sample size
q <- 1                      # number of covariates

# State space
states_all <- c("PFS", "PD", "Death")

# ----------------------------------------------------------------------------
# 2. True beta trajectories (U-shaped, from existing code)
# ----------------------------------------------------------------------------

beta <- matrix(0, nrow = M, ncol = K)
for(t in 1:K) {
  x <- t
  si <- 60
  mu <- 130
  beta[1, t] <- (-1) * 40 * si^(-1) * exp((-(x - 130)^2) / (2 * si^2))
  beta[2, t] <- 45 * si^(-1) * exp((-(x - 130)^2) / (2 * si^2))
  beta[3, t] <- (-1) * 40 * si^(-1) * exp((-(x - 130)^2) / (2 * si^2))
  beta[4, t] <- (-1) * 40 * si^(-1) * exp((-(x - 130)^2) / (2 * si^2))
}

# ----------------------------------------------------------------------------
# 3. Baseline hazard parameters (Weibull)
# ----------------------------------------------------------------------------

lambda_pfs <- 0.001
kappa_pfs <- 1.2
lambda_pd <- 0.01
kappa_pd <- 0.9
lambda_pfs_d <- 0.0002
kappa_pfs_d <- 1.0
lambda_pd_d <- 0.002
kappa_pd_d <- 1.0

# Transition path definitions: list(origin, destination, kappa, lambda, beta_row_index)
params <- list(
  c("PFS", "PD", kappa_pfs, lambda_pfs, 1),      # m = 1: PFS -> PD
  c("PD", "PFS", kappa_pd, lambda_pd, 2),        # m = 2: PD -> PFS
  c("PFS", "Death", kappa_pfs_d, lambda_pfs_d, 3), # m = 3: PFS -> Death
  c("PD", "Death", kappa_pd_d, lambda_pd_d, 4)   # m = 4: PD -> Death
)

# ----------------------------------------------------------------------------
# 4. Covariate setup
# ----------------------------------------------------------------------------

x_list <- list()
x_list[[1]] <- matrix(1, nrow = n_patients, ncol = K)
x_list[[1]][1:(n_patients/2), ] <- 0
names(x_list) <- c("Covariate1")

beta_list <- list()
beta_list[[1]] <- beta
names(beta_list) <- c("Covariate1")

    
transition_prob_one_lag <- function(origin_state, sojourn_time,
                                    patient_id, time_idx, params) {
  prob <- setNames(rep(0, length(states_all)), states_all)

  # Death is absorbing.
  if (origin_state == "Death") {
    prob["Death"] <- 1
    return(prob)
  }

  possible_trans <- Filter(
    function(x) x[1] == origin_state,
    params
  )

  if (length(possible_trans) == 0) {
    prob[origin_state] <- 1
    return(prob)
  }

  if (!is.finite(sojourn_time) || sojourn_time <= 0) {
    stop("sojourn_time must be finite and positive")
  }

  hazard <- numeric(length(possible_trans))
  destination <- character(length(possible_trans))

  for (j in seq_along(possible_trans)) {
    trans <- possible_trans[[j]]

    kappa <- as.numeric(trans[3])
    lambda <- as.numeric(trans[4])
    beta_row_index <- as.numeric(trans[5])
    destination[j] <- trans[2]

    eta <- 0

    for (v in 1:q) {
      # beta is indexed by sojourn time rather than global time.
      beta_time_idx <- as.integer(ceiling(sojourn_time / interval))
      beta_time_idx <- max(
        1L,
        min(beta_time_idx, ncol(beta_list[[v]]))
      )

      # The covariate remains indexed by the current observation time.
      covariate_time_idx <- max(
        1L,
        min(as.integer(time_idx), ncol(x_list[[v]]))
      )

      eta <- eta +
        x_list[[v]][patient_id, covariate_time_idx] *
        beta_list[[v]][beta_row_index, beta_time_idx]
    }

    hazard[j] <- lambda * kappa *
      sojourn_time^(kappa - 1) *
      exp(eta)
  }

  total_hazard <- sum(hazard)

  if (!is.finite(total_hazard) || total_hazard <= 0) {
    prob[origin_state] <- 1
    return(prob)
  }

  # Probability of at least one transition during the interval.
  event_prob <- 1 - exp(-total_hazard * interval)

  # Probability of remaining in the lagged origin state.
  prob[origin_state] <- 1 - event_prob

  # Competing transition probabilities.
  for (j in seq_along(hazard)) {
    prob[destination[j]] <- prob[destination[j]] +
      event_prob * hazard[j] / total_hazard
  }

  return(prob)
}
sim_one_patient_ho <- function(patient_id, params, tmax = K, start_state,
                               psi, phi = NULL) {
  if (is.null(phi)) {
    phi <- rep(0, psi)
    phi[1] <- 1
  }
  if (length(phi) != psi) {
    stop("Length of phi must equal psi")
  }
  if (any(phi < 0) || abs(sum(phi) - 1) > 1e-10) {
    stop("phi must be nonnegative and sum to 1")
  }

  # state_path[k + 1] is the state at time k.
  state_path <- rep(NA_character_, tmax + 1)
  sojourn_path <- rep(NA_real_, tmax + 1)
  state_path[1] <- start_state
  sojourn_path[1] <- interval

  for (t in 1:tmax) {
    current_state <- state_path[t]

    if (current_state == "Death") {
      state_path[(t + 1):(tmax + 1)] <- "Death"
      break
    }

    # Method S6: each lagged state produces a complete one-step transition
    # probability vector; phi then combines those vectors.
    transition_prob <- setNames(rep(0, length(states_all)), states_all)

    for (l in 1:psi) {
      # When t < l, use the observed initial state for the unavailable
      # pre-baseline history, as in the original fallback rule.
      lag_position <- max(1, t - l + 1)
      lag_state <- state_path[lag_position]
      lag_sojourn <- sojourn_path[lag_position]

      lag_prob <- transition_prob_one_lag(
        origin_state = lag_state,
        sojourn_time = lag_sojourn,
        patient_id = patient_id,
        time_idx = min(t, K),
        params = params
      )

      transition_prob <- transition_prob + phi[l] * lag_prob
    }

    transition_prob <- pmax(transition_prob, 0)
    transition_prob <- transition_prob / sum(transition_prob)
    next_state <- sample(states_all, 1, prob = transition_prob)

    state_path[t + 1] <- next_state
    sojourn_path[t + 1] <- if (next_state == current_state) {
      sojourn_path[t] + interval
    } else {
      interval
    }
  }

  # Keep the original trajectory interface so that sur_traj() and all
  # downstream wide_data code remain unchanged.
  change_position <- which(state_path[-1] != state_path[-length(state_path)]) + 1
  keep_position <- c(1, change_position)
  traj <- data.frame(
    time = (keep_position - 1) * interval,
    state = state_path[keep_position],
    event = c("Enter", rep("Transfer", length(change_position)))
  )

  if (tail(state_path, 1) != "Death") {
    traj <- rbind(
      traj,
      data.frame(time = tmax, state = tail(state_path, 1), event = "Censored")
    )
  }

  traj
}

#' Convert continuous trajectory to discrete-time state chain
sur_traj <- function(traj, tp) {
  states <- rep(NA, length(tp))
  for (i in 1:length(tp)) {
    t <- tp[i]
    idx <- which(traj$time <= t)
    if (length(idx) > 0) {
      states[i] <- traj$state[max(idx)]
    }
  }
  return(states)
}


simulate_mmi_scenario <- function(psi, phi, n_patients = n_patients, K = 260, 
                                  tp = seq(0, K, 1), params, 
                                  prob_start = c(0.75, 0.25), seed = 123) {
  
  set.seed(seed)
  
  cat("Simulating nominal order =", psi, "with phi =", paste(round(phi, 3), collapse = ", "), "\n")
  start_time <- Sys.time()
  
  discrete_chains <- list()
  pb <- txtProgressBar(min = 0, max = n_patients, style = 3)
  
  for (i in 1:n_patients) {
    # Sample initial state
    start_state <- sample(c("PFS", "PD"), 1, prob = prob_start)
    
    # Simulate trajectory with higher-order dependence
    cont_traj <- sim_one_patient_ho(
      patient_id = i, 
      params = params, 
      tmax = K, 
      start_state = start_state,
      psi = psi,
      phi = phi
    )
    
    # Convert to discrete time chain
    states <- sur_traj(cont_traj, tp)
    
    # Store as data frame
    discrete_chains[[i]] <- data.frame(
      PatientID = i,
      Time = tp,
      State = states
    )
    
    setTxtProgressBar(pb, i)
  }
  
  close(pb)
  
  end_time <- Sys.time()
  cat("\nCompleted in", round(end_time - start_time, 2), "seconds\n")
  
  # Column 1 contains the state at t = 0.
# Columns 2:(K + 1) contain the states at t = 1,...,K.
  wide_data <- do.call(rbind, lapply(discrete_chains, function(df) {
    # Convert states to numeric: PFS=1, PD=2, Death=3
    state_num <- as.numeric(factor(df$State, 
                                   levels = c("PFS", "PD", "Death"),
                                   labels = c(1, 2, 3)))
    # Row: initial state + states at all time points
    row_vec <- state_num
    names(row_vec) <- c("init_state", paste0("t_", seq_len(K)))
    stopifnot(length(row_vec) == K + 1L)
    return(row_vec)
  }))
  
  wide_data <- as.data.frame(wide_data)
  
  return(wide_data)
}

