#8. zbic function
zw_mse <- function(y_true, y_pred, tau = log(1.25)) {
  stopifnot(length(y_true) == length(y_pred), is.finite(tau), tau > 0)
  ok <- is.finite(y_true) & is.finite(y_pred)
  y_true <- y_true[ok]
  y_pred <- y_pred[ok]
  if (!length(y_true)) return(NA_real_)
  w <- exp(- (y_true^2) / (2 * tau^2))
  mse <- sum(w * (y_true - y_pred)^2) / sum(w)
  return(mse)
}
zbic<-function(y_true, y_pred, n_parm, tau = log(1.25)){
  stopifnot(length(y_true) == length(y_pred), n_parm > 0)
  ok <- is.finite(y_true) & is.finite(y_pred)
  y_true <- y_true[ok]
  y_pred <- y_pred[ok]
  K_now <- length(y_true)
  if (K_now <= 1) return(Inf)
  loss <- max(zw_mse(y_true, y_pred, tau = tau), .Machine$double.eps)
  zbic_values <- K_now * log(loss) + log(K_now) * n_parm
  return(zbic_values)
}

#9.95%ci
boot_ci <- function(x, B = 2000L, conf = 0.95, digits = 2L) {
  x <- x[is.finite(x)]

  if (length(x) < 2L) {
    return(NA_character_)
  }

  boot_mean <- replicate(
    B,
    mean(sample(x, length(x), replace = TRUE))
  )

  alpha <- 1 - conf

  ci <- quantile(
    boot_mean,
    probs = c(alpha / 2, 1 - alpha / 2),
    names = FALSE
  )

  sprintf(
    paste0("(%.", digits, "f, %.", digits, "f)"),
    ci[1], ci[2]
  )
}
