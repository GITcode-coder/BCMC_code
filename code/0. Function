#1. sampling time from weibull (considering covariate effects)
  sample_tran_time <- function(kappa, lambda, beta_row_index, patient_id, entry_time, tmax, q,interval=1) {
    # Generate uniform random number
    U <- runif(1)
    if (U <= 0) return(Inf)
    if (U >= 1) return(entry_time)
    
    entry_time_int <- ceiling(entry_time)
    
    max_search_time <- min(tmax, entry_time_int + 1000)
    
    for (t in entry_time_int:max_search_time) {
      cumulative_hazard <- 0
      
      for (s in entry_time_int:t) {
        s_state <- s - entry_time
        if (s_state <= 0) next
        
        # h0(t) = lambda * kappa * t^(kappa-1)
        h0 <- lambda * kappa * (s_state)^(kappa - 1)
        time_idx <- min(max(1, as.integer(ceiling(s_state / interval))),K)
        eta <- 0
        for (j in 1:q) {
          x_j <- x_list[[j]][patient_id, time_idx]
          beta_j <- beta_list[[j]][beta_row_index, time_idx]
          eta <- eta + x_j * beta_j
        }
      
        cumulative_hazard <- cumulative_hazard + h0 * exp(eta)
      }
      
      if (exp(-cumulative_hazard) < U) {
        return(t)
      }
    }
    
    return(max_search_time)
  }
  
#2.Simulate the complete trajectory of a single patient
  sim_one_patient <- function(patient_id, params, tmax = K, start_state) {
    current_state <- start_state
    entry_time <- 0
    traj <- data.frame(time = entry_time, state = current_state, event = "Enter")
    
    while (current_state != "Death" & entry_time < tmax) {
      
      possible_trans <- Filter(function(x) x[1] == current_state, params)
      if (length(possible_trans) == 0) break
      
      times <- numeric(length(possible_trans))
      
      for (j in 1:length(possible_trans)) {
        trans <- possible_trans[[j]]
        kappa <- as.numeric(trans[3])
        lambda <- as.numeric(trans[4])
        beta_row_index <- as.numeric(trans[5]) # m=1,2,3,4
        
        t_sample <- sample_tran_time(kappa, lambda,  beta_row_index, patient_id, entry_time, tmax, q,interval=1)
        times[j] <- t_sample
      }
      
      next_time <- min(times)
      if (next_time >= tmax) break
      
      idx <- which.min(times)
      next_state <- possible_trans[[idx]][2]
      
      traj <- rbind(traj,
                    data.frame(time = next_time, 
                               state = next_state, 
                               event = "Transfer"))
      
      current_state <- next_state
      entry_time <- next_time
    
      if (nrow(traj) > 300) break
    }
    
    if (current_state != "Death" & entry_time < tmax) {
      traj <- rbind(traj,
                    data.frame(time = tmax,
                               state = current_state,
                               event = "Censored"))
    }
    
    return(traj)
  }
  
#3. Convert continuous trajectories into discrete-time state chains
  sur_traj <- function(traj, tp) {
    states <- rep(NA, length(tp))
    for (i in 1:length(tp)) {
      t <- tp[i]
     
      idx <- which(traj$time <= t)
      if (length(idx) > 0) {
        states[i] <- traj$state[max(idx)]
      }
    }
    return(states)
  }
#4. Extracted  survival time data
  data_sur_extract<-function(wide_data,x_list,q){
    library(foreach)
    library(iterators)
    library(parallel)
    library(doParallel)
    library(data.table)
    n.cores<-detectCores()
    cl <- makeCluster(10) 
    registerDoParallel(cl)
    C0<-c()
    #generate chain data
    data<-wide_data
    num<-dim(data)[1]
    k0<-dim(data)[2]
    C0<-foreach(i = 1:num,
                .combine = rbind,
                .packages = c("dplyr"),
                .errorhandling = "pass") %dopar% {
                  #generate chain data    
                  c<-c(0)
                  Time<-c(rep(1, k0))
                  s<-c(rep(0, k0))
                  d<-as.numeric(data[i,])
                  sit<-min(which(is.na(d)==FALSE))#if have NA
                  for(t in sit:(k0-1)){
                    Time[t+1]<-ifelse(d[t]==d[t+1],Time[t]+1,1)
                    if ((d[t]==1)&(d[t+1]==2)) {s[t]<-1}
                    else if ((d[t]==2)&(d[t+1]==1)) {s[t] <- 2}
                    else if ((d[t]==1)&(d[t+1]==3)) {s[t] <- 3} 
                    else if ((d[t]==2)&(d[t+1]==3)) {s[t] <- 4}
                    else s[t]<-0
                  }
                  Time<-Time[sit:k0]
                  s<-s[sit:k0]
                  #covariants information
                  X<-NA
                  for(qq in 1:q){
                    X<-rbind(X,x_list[[qq]][i,])}
                  X<-as.data.frame(X[,sit:(k0-1)])
                  X<-cbind(X[-1,1],X[-1,])
                  
                  #(1) A completed sojourn contributes one record to every
                  #    transition-specific risk set emanating from its origin.
                  #    The realized transition has event=1; competing exits have
                  #    event=0 at exactly the same clock-reset duration.
                  event_idx <- which(s != 0)
                  if (length(event_idx) > 0) {
                    for (idx in event_idx) {
                      origin_state <- d[idx]
                      realized_m <- abs(s[idx])
                      candidate_m <- if (origin_state == 1) c(1, 3) else c(2, 4)
                      for (m0 in candidate_m) {
                        ci <- as.matrix(t(c(
                          ID = i,
                          y = Time[idx],
                          m = m0,
                          sigema = as.integer(m0 == realized_m),
                          K = idx,
                          X = X[,idx]
                        )))
                        c <- rbind(c, ci)
                      }
                    }
                  }
                  #(2) No transfer occurred at the last point in time
                  if(last(Time)>1){
                    if(last(d)==1|last(d)==2){#censoring data
                      ci2<-as.matrix(t(c(ID=i,y=last(Time)-1,m=last(d),sigema=0,K=k0-1,X=X[,k0])))
                      ci3<-as.matrix(t(c(ID=i,y=last(Time)-1,m=last(d)+2,sigema=0,K=k0-1,X=X[,k0])))
                      #m=1 in the last time correspond the censoring data of m=1/m=3;
                      #m=2 in the last time correspond the censoring data of m=2/m=4
                      c<-rbind(c,ci2,ci3)}
                  }
                  
                  #(3) pfs/pd-d
                  if(last(d)==1|last(d)==2){
                    ci4<-as.matrix(t(c(ID=i,y=k0-sit,m=5,sigema=0,K=k0-1,X=X[,k0])))
                    c<-rbind(c,ci4)}
                  if(last(d)==3){ 
                    if(d[sit]==1|d[sit]==2){
                      ci5<-as.matrix(t(c(ID=i,y=min(which(d==3))-sit,m=5,sigema=1,K=min(which(d==3)),X=X[,min(which(d==3))])))
                      c<-rbind(c,ci5) }
                    if(d[sit]==3){c<-c}}
                  
                  c<-c[-1,]
                  return(c)
                }
    
    stopCluster(cl)
    C1<-as.data.frame(C0)
    names(C1)[names(C1) == "sigema"] <- "sigema"
    stopifnot(all(C1$m %in% 1:5), all(C1$y >= 0))
    return(C1)
  }

#5. beta estimation of Fre-Cox,TVC-Cox, RCS-Cox
  beta_of_HR_cox<-function(data_sur,M){
    library(survival)
    HR_cox<-matrix(0,M,3)
    for(m in c(1:M)){
      data0<-data_sur[which(data_sur$m==m),]
      data<-list(y=data0$y,group=data0$X,delta=data0$sigema)
      res.cox <- coxph(Surv(y, delta) ~ group, data = data)
      sum<-summary(res.cox)
      HR_cox[m,]<-cbind(sum$coefficients[2],sum$conf.int[3],sum$conf.int[4])
    }
    colnames(HR_cox)<-c("HR","low","upr")
    return(HR_cox)
  }
  beta_of_HR_TV <- function(data_sur, M, K) {
  library(survival)
  HR_TV <- matrix(NA_real_,nrow = K,ncol = M * 3)
  time_grid <- seq_len(K)
  log_time <- log(time_grid)

  time_parallel <- system.time({
for (m in seq_len(M)) {
data0 <- data_sur[data_sur$m == m, , drop = FALSE]
data <- data.frame(y = as.numeric(data0$y),group = as.numeric(as.character(data0$X)),delta = as.numeric(data0$sigema))
data <- data[is.finite(data$y) &is.finite(data$group) &is.finite(data$delta) &data$y > 0,,drop = FALSE]
fit <- coxph(Surv(y, delta) ~ group + tt(group),data = data,tt = function(x, t, ...) {
          x * log(pmax(t, 1))
        })
coefficient <- coef(fit)
covariance <- vcov(fit)

coefficient_index <- match(c("group", "tt(group)"),names(coefficient))
beta_hat <- coefficient[coefficient_index]
variance_hat <- covariance[coefficient_index,coefficient_index,drop = FALSE ]

# beta(t) = beta_1 + beta_2 log(t)
design_matrix <- cbind(main_effect = 1,time_interaction = log_time)
log_hr <- as.numeric(design_matrix %*% beta_hat)
# Var[beta_1 + log(t) beta_2]
log_hr_variance <- rowSums((design_matrix %*% variance_hat) * design_matrix)
log_hr_se <- sqrt(pmax(log_hr_variance, 0))
critical_value <- qnorm(0.975)
result <- cbind(
  HR = exp(log_hr),
  low = exp(log_hr - critical_value * log_hr_se),
  upr = exp(log_hr + critical_value * log_hr_se)
      )
columns <- ((m - 1) * 3 + 1):((m - 1) * 3 + 3)
HR_TV[, columns] <- result
    }
})
colnames(HR_TV) <- unlist(
lapply(seq_len(M), function(m) {
      c(
        paste0("TVC.", m),
        paste0("TVC_lwr.", m),
        paste0("TVC_upr.", m)
      )
    })
  )

  HR_TV <- as.data.frame(HR_TV)
  HR_TV$elapsed <- as.numeric(time_parallel["elapsed"])

  return(HR_TV)
}
  beta_of_HR_rcs <- function(data_sur, M, K) {

  library(survival)
  library(casebase)
  library(splines)

  # HR、lower、upper
  HR_rcs <- matrix(NA_real_,nrow = K,ncol = M * 3)
  fit <- vector( "list", M)
  time_parallel <- system.time({

    for (m in seq_len(M)) {
 data0 <- data_sur[data_sur$m == m,,drop = FALSE]
 data <- data.frame(y = as.numeric(data0$y),group = factor(as.character(data0$X),levels = c("0", "1")),delta = as.numeric(data0$sigema))
 data$t_sojourn <- data$y
 data <- data[
        is.finite(data$y) &
          is.finite(data$delta) &
          !is.na(data$group) &
          data$y > 0,
        ,
        drop = FALSE
      ]
      if (nrow(data) == 0) {
        warning(
          "Transition ", m,
          ": no valid observations."
        )
        next
      }

      if (length(unique(data$group)) < 2) {
        warning(
          "Transition ", m,
          ": only one group is present; HR cannot be estimated."
        )
        next
      }

      if (sum(data$delta == 1) == 0) {
        warning(
          "Transition ", m,
          ": no events are present; HR cannot be estimated."
        )
        next
      }

      cat(
        "\nTransition", m, "\n"
      )
      cat(
        "Observed sojourn-time range:",
        paste(range(data$y), collapse = " - "),
        "\n"
      )
     boundary_knots <- c(1, K)
    fit[[m]] <- tryCatch({
    fitSmoothHazard(delta ~group *bs(t_sojourn,df = 3,degree = 3,Boundary.knots = boundary_knots),data = data,time = "y")
      }, error = function(e) {

        warning(
          "Transition ", m,
          " fitting failed: ",
          conditionMessage(e)
        )

        NULL
      })

      if (is.null(fit[[m]])) {
        next
      }

      coefficient_values <- coef(
        fit[[m]]
      )

      if (any(!is.finite(coefficient_values))) {

        warning(
          "Transition ", m,
          ": non-finite coefficients. ",
          "The time-varying HR is not identifiable."
        )

        next
      }

      newtime <- seq_len(K)

      newdata0 <- data.frame(
        group = factor(
          rep("0", K),
          levels = c("0", "1")
        ),
        t_sojourn = newtime,
        y = newtime
      )

      p1 <- tryCatch({

        plot(
          fit[[m]],
          newdata = newdata0,
          var = "group",
          increment = 1,
          xvar = "t_sojourn",
          type = "hr",
          ci = TRUE,
          ci.lvl = 0.95,
          rug = FALSE,
          ylim = c(0, 10)
        )

      }, error = function(e) {

        warning(
          "Transition ", m,
          " prediction failed: ",
          conditionMessage(e)
        )

        NULL
      })

      if (is.null(p1)) {
        next
      }

      if (
        !all(
          c(
            "hazard_ratio",
            "lowerbound",
            "upperbound"
          ) %in% names(p1)
        )
      ) {
        warning(
          "Transition ", m,
          ": plot() did not return the expected HR columns."
        )
        next
      }

      if (nrow(p1) != K) {
        warning(
          "Transition ", m,
          ": expected ", K,
          " predictions but received ",
          nrow(p1), "."
        )
        next
      }

      col_start <- (m - 1) * 3 + 1

      HR_rcs[, col_start] <-
        as.numeric(p1$hazard_ratio)

      HR_rcs[, col_start + 1] <-
        as.numeric(p1$lowerbound)

      HR_rcs[, col_start + 2] <-
        as.numeric(p1$upperbound)
    }
  })

  output_names <- unlist(
    lapply(seq_len(M), function(m) {
      c(
        paste0("TVC.", m),
        paste0("TVC_lwr.", m),
        paste0("TVC_upr.", m)
      )
    })
  )

  colnames(HR_rcs) <- output_names
  HR_rcs <- cbind(
    as.data.frame(HR_rcs),
    elapsed = as.numeric(
      time_parallel["elapsed"]
    )
  )

  return(HR_rcs)
}
