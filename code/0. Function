#7. weibull/linear/smooth spline fit and 95%ci
  smooth_bcmc_curve <- function(y, model, m, spline_df  = NULL){
    K_now <- length(y)
    if (model == "linear") {
      dat_fit<-as.data.frame(cbind(y,1:K_now))
      colnames(dat_fit)<-c("y","x")
      fit<-lm(y~x,data=dat_fit)
      return(as.numeric(fitted(fit)))
    }
    if (model == "spline") {
      library(splines)
      x<-1:K_now
      fit <- smooth.spline(x,y,df = spline_df ,all.knots = TRUE)
      fitted_values <- predict(fit,x = x)$y
      return(as.numeric(fitted_values))
    }
    if (model == "weibull") {
      base <- 1
      inter <- 1
      x_new <- seq_len(K_now)
      positive_area <- sum(pmax(y - 1, 0) * inter, na.rm = TRUE)
      negative_area <- sum(pmax(1 - y, 0) * inter, na.rm = TRUE)
      direction <- if (positive_area >= negative_area) 1 else -1
      y_adj <- if (direction == 1) pmax(y - base, 0) else pmax(base - y, 0)
      redu <- sum(y_adj* inter, na.rm = TRUE)
      if (!is.finite(redu) || redu <= .Machine$double.eps) {return(rep(base, K_now))}
      y_norm <- y_adj / redu
      prob_vec <- abs(y_norm)
      prob_vec <- prob_vec / sum(prob_vec)
    weibull_nll <- function(log_par) {
    shape <- exp(log_par[1])
    scale <- exp(log_par[2])

    log_density <- dweibull(x_new,shape = shape,scale = scale,log = TRUE)
   if (any(!is.finite(log_density))) {
      return(.Machine$double.xmax)
    }

    -sum(prob_vec * log_density)
  }

  scale_start <- max(
    sum(x_new * prob_vec),
    .Machine$double.eps
  )

  fit <- tryCatch(
    optim(
      par = log(c(shape = 1, scale = scale_start)),
      fn = weibull_nll,
      method = "L-BFGS-B",
      lower = log(c(0.05, 0.05)),
      upper = log(c(50, 10 * K_now))
    ),
    error = function(e) NULL
  )
  if (is.null(fit) || fit$convergence != 0) {
    shape0 <- 1
    scale0 <- scale_start
  } else {
    shape0 <- exp(fit$par[1])
    scale0 <- exp(fit$par[2])
  }
weibull_density <- dweibull(x_new,shape = shape0,scale = scale0)
density_area <- sum(weibull_density * inter)
if (!is.finite(density_area) ||
    density_area <= .Machine$double.eps) {return(rep(base, K_now))}
weibull_density <- weibull_density / density_area
  weibull_scaled <- base + weibull_density * redu * direction
  return(as.numeric(weibull_scaled))
    }
  }

  smooth_bcmc_posterior <- function(mean_hr, posterior_hr, model, m, spline_df = NULL){
    fitted_mean <- smooth_bcmc_curve(mean_hr, model, m, spline_df)
    fitted_draws <- do.call(rbind, lapply(1:nrow(posterior_hr), function(i) {
      smooth_bcmc_curve(as.numeric(posterior_hr[i, ]),  model, m, spline_df )
    }))
    y_lwr <- apply(fitted_draws, 2, quantile, probs = 0.025, na.rm = TRUE)
    y_upr <- apply(fitted_draws, 2, quantile, probs = 0.975, na.rm = TRUE)
    cbind(fitted_mean, y_lwr, y_upr)
  }
beta_fit_wei<-function(bcmc,bcmc_posterior,M,K){
  library(MASS)
