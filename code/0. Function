  beta1[1] ~ dnorm(0, 1/(v1*v1))#sd[1]

  # 2.# σ_β² ：half-Cauchy(0, s0)
 sigma_beta ~ dt(0, 1/pow(s0, 2), 1) T(0,) 
sigma_beta_sq <- pow(sigma_beta, 2)    
  
  # 2. j=2,...,K: (β_j - β_{j-1}) ~ N(0, σ_β²)
  for(kk in 2:K) {
    beta1[kk] ~ dnorm(beta1[kk-1], 1/(sigma_beta_sq))
